NODE_ENV=production
# Render supplies PORT; do not override it in the service dashboard.
PORT=10000
DATABASE_URL=postgresql://replace-role:replace-password@replace-neon-host.invalid/replace-database?sslmode=verify-full
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=https://replace-frontend-host.invalid
# Proposed for direct onrender.com hosting; verify the proxy chain before release.
TRUST_PROXY_HOPS=1
DB_POOL_MAX=5
