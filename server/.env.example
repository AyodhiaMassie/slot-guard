NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://slotguard:replace-with-local-password@127.0.0.1:5432/slotguard
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
# Trust a proxy only when the server is actually behind that many trusted hops.
TRUST_PROXY_HOPS=0
DB_POOL_MAX=10
